<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional: start the Fengshui server at login.
     cp scripts/com.chevin.fengshui.server.plist ~/Library/LaunchAgents/ && \
     launchctl load ~/Library/LaunchAgents/com.chevin.fengshui.server.plist
     Edit the path below if the repo isn't at ~/Developer/fengshui. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chevin.fengshui.server</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>~/Developer/fengshui/scripts/run_server.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/fengshui-server.log</string>
  <key>StandardErrorPath</key><string>/tmp/fengshui-server.log</string>
</dict>
</plist>
