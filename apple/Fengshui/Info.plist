<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.chevin.fengshui.refresh</string>
		<string>com.chevin.fengshui.processing</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Fengshui</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_fengshui._tcp</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Fengshui reads your Health data to detect activity and plan your evening wind-down. Data stays on your iPhone and your own Mac.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Fengshui saves the recording sessions you start on your Apple Watch as workouts.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Fengshui syncs with the Fengshui server on your own Mac over your home network.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Fengshui notes when you arrive at or leave your saved places (like Home and Work) to plan your evening. It never tracks a continuous route.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fengshui uses your location to set your saved places.</string>
	<key>NSMotionUsageDescription</key>
	<string>Fengshui reads your iPhone's motion activity (walking, driving…) to label your day.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
